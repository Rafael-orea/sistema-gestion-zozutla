<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.EnvioController"
      spacing="16"
      style="-fx-padding: 30; -fx-background-color: #F5F0E8;">

    <Label text="HISTORIAL DE ENVIOS"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="FECHA:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <DatePicker fx:id="fechaPicker" prefWidth="150"/>

        <Label text="CLIENTE:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <TextField fx:id="clienteSearchField"
                   promptText="Buscar cliente..."
                   prefWidth="200" prefHeight="34"
                   style="-fx-background-color: #EDE8DC;
                          -fx-border-color: #C0B090;
                          -fx-border-width: 1;
                          -fx-padding: 6;"/>

        <Label text="ESTADO:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <ComboBox fx:id="filtroEstado" prefWidth="180"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="BUSCAR"
                onAction="#handleBuscar"
                prefHeight="34"
                style="-fx-background-color: #2B2118;
                       -fx-text-fill: #F5F0E8;
                       -fx-font-size: 12px;
                       -fx-font-weight: bold;
                       -fx-padding: 6 16;
                       -fx-cursor: hand;"/>

        <Button text="LIMPIAR"
                onAction="#handleLimpiar"
                prefHeight="34"
                style="-fx-background-color: #EDE8DC;
                       -fx-border-color: #2B2118;
                       -fx-border-width: 1;
                       -fx-font-size: 12px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #2B2118;
                       -fx-padding: 6 16;
                       -fx-cursor: hand;"/>

        <Button text="+ Agregar envio"
                onAction="#handleAgregarEnvio"
                prefHeight="34"
                style="-fx-background-color: #6B4423;
                       -fx-text-fill: #F5F0E8;
                       -fx-font-size: 12px;
                       -fx-font-weight: bold;
                       -fx-padding: 6 16;
                       -fx-cursor: hand;"/>
    </HBox>

    <ListView fx:id="clienteListView"
              prefHeight="90"
              style="-fx-background-color: #EDE8DC;
                     -fx-border-color: #C0B090;
                     -fx-border-width: 1;"/>

    <TableView fx:id="envioTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #EDE8DC;
                      -fx-border-color: #C8BFA8;
                      -fx-border-width: 1;">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colFolio" text="FOLIO" prefWidth="160"/>
            <TableColumn fx:id="colCliente" text="CLIENTE" prefWidth="140"/>
            <TableColumn fx:id="colDestino" text="DESTINO" prefWidth="130"/>
            <TableColumn fx:id="colFlete" text="FLETE" prefWidth="110"/>
            <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="120"/>
            <TableColumn fx:id="colAcciones" text="ACCIONES" prefWidth="220"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="6">
        <Label text="Total de envios:"
               style="-fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <Label fx:id="totalLabel" text="0"
               style="-fx-text-fill: #2B2118;"/>
    </HBox>

</VBox>