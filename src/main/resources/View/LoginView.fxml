<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.LoginController"
      alignment="CENTER"
      spacing="60"
      prefWidth="700" prefHeight="500"
      style="-fx-background-color: #F5F0E8; -fx-padding: 40;">

    <children>
        <ImageView fx:id="logoImage"
                   fitWidth="200" fitHeight="200"
                   preserveRatio="true"/>

        <VBox spacing="20" alignment="CENTER">
            <Label text="INICIO DE SESIÓN"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B2A1A;"/>

            <VBox spacing="6">
                <Label text="USUARIO"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #3B2A1A;"/>
                <TextField fx:id="usernameField"
                           prefWidth="260" prefHeight="36"
                           style="-fx-background-color: #EDE8DC;
                                  -fx-border-color: #C0B090;
                                  -fx-border-width: 1;
                                  -fx-padding: 6;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="CONTRASEÑA"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #3B2A1A;"/>
                <PasswordField fx:id="passwordField"
                               prefWidth="260" prefHeight="36"
                               style="-fx-background-color: #EDE8DC;
                                      -fx-border-color: #C0B090;
                                      -fx-border-width: 1;
                                      -fx-padding: 6;"/>
            </VBox>

            <Button text="ENTRAR"
                    onAction="#handleLogin"
                    prefWidth="160" prefHeight="40"
                    style="-fx-background-color: #E8E0D0;
                           -fx-border-color: #3B2A1A;
                           -fx-border-width: 1;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #3B2A1A;
                           -fx-cursor: hand;"/>
        </VBox>
    </children>
</HBox>