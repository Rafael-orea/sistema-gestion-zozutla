<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.VentaController"
      spacing="14"
      style="-fx-padding: 30; -fx-background-color: #F5F0E8;">

    <Label text="REGISTRO DE VENTA"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <!-- Tipo de precio -->
    <HBox spacing="20" alignment="CENTER_LEFT"
          style="-fx-background-color: #EDE8DC;
                 -fx-border-color: #C0B090;
                 -fx-border-width: 1;
                 -fx-padding: 10;
                 -fx-background-radius: 4;
                 -fx-border-radius: 4;">
        <Label text="TIPO DE PRECIO:"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <RadioButton fx:id="rbNormal" text="Precio Normal"
                     style="-fx-font-size: 13px; -fx-text-fill: #2B2118;"/>
        <RadioButton fx:id="rbMayoreo" text="Precio Mayoreo"
                     style="-fx-font-size: 13px; -fx-text-fill: #2B2118;"/>
    </HBox>

    <!-- Cliente -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="CLIENTE:"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <TextField fx:id="clienteSearchField"
                   promptText="Buscar cliente registrado..."
                   prefWidth="280" prefHeight="34"
                   style="-fx-background-color: #EDE8DC;
                          -fx-border-color: #C0B090;
                          -fx-border-width: 1;
                          -fx-padding: 6;"/>
        <Button text="Comprador Normal"
                onAction="#handleCompradorNormal"
                prefHeight="34"
                style="-fx-background-color: #6B5A45;
                       -fx-text-fill: white;
                       -fx-font-size: 12px;
                       -fx-padding: 6 12;
                       -fx-cursor: hand;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="FECHA:"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <DatePicker fx:id="fechaPicker" prefWidth="150"/>
    </HBox>

    <ListView fx:id="clienteListView"
              prefHeight="100"
              style="-fx-background-color: #EDE8DC;
                     -fx-border-color: #C0B090;
                     -fx-border-width: 1;"/>

    <!-- Info cliente seleccionado -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="clienteSeleccionadoLabel"
               text="Sin cliente seleccionado"
               style="-fx-text-fill: #6B5A45; -fx-font-style: italic;"/>
        <Label fx:id="descuentoLabel" text=""
               style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Tabla de productos -->
    <TableView fx:id="detalleTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #EDE8DC;
                      -fx-border-color: #C8BFA8;
                      -fx-border-width: 1;">
        <columns>
            <TableColumn fx:id="colProducto" text="PRODUCTO" prefWidth="220"/>
            <TableColumn fx:id="colCantidad" text="CANTIDAD" prefWidth="90"/>
            <TableColumn fx:id="colPrecio" text="PRECIO" prefWidth="100"/>
            <TableColumn fx:id="colDescuento" text="DESCUENTO" prefWidth="90"/>
            <TableColumn fx:id="colSubtotal" text="SUBTOTAL" prefWidth="100"/>
            <TableColumn fx:id="colEliminar" text="" prefWidth="50"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Button text="+ agregar producto"
            onAction="#handleAgregarProducto"
            style="-fx-background-color: transparent;
                   -fx-border-color: #C0B090;
                   -fx-border-width: 1;
                   -fx-font-size: 12px;
                   -fx-text-fill: #6B5A45;
                   -fx-padding: 6 16;
                   -fx-cursor: hand;"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label text="TOTAL:"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <Label fx:id="totalLabel" text="0.00"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
    </HBox>

    <HBox spacing="20" alignment="CENTER">
        <Button text="REGISTRAR VENTA"
                onAction="#handleRegistrarVenta"
                prefWidth="200" prefHeight="40"
                style="-fx-background-color: #2B2118;
                       -fx-text-fill: #F5F0E8;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>
        <Button text="PANEL PRINCIPAL"
                onAction="#handlePanelPrincipal"
                prefWidth="200" prefHeight="40"
                style="-fx-background-color: #EDE8DC;
                       -fx-border-color: #2B2118;
                       -fx-border-width: 1;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #2B2118;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>