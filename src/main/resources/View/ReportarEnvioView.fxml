<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.ReportarEnvioController"
      spacing="16"
      prefWidth="700" prefHeight="650"
      style="-fx-padding: 30; -fx-background-color: #F5F0E8;">

    <Label text="REPORTAR ENVIO"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <!-- Buscador de folio -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="VENTA:"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <TextField fx:id="folioSearchField"
                   promptText="Buscar folio de venta..."
                   prefWidth="300" prefHeight="34"
                   style="-fx-background-color: #EDE8DC;
                          -fx-border-color: #C0B090;
                          -fx-border-width: 1;
                          -fx-padding: 6;"/>
    </HBox>

    <ListView fx:id="folioListView"
              prefHeight="110"
              style="-fx-background-color: #EDE8DC;
                     -fx-border-color: #C0B090;
                     -fx-border-width: 1;"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="CLIENTE:"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <Label fx:id="clienteLabel" text="----------"
               style="-fx-text-fill: #6B5A45;"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="DESTINO:"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <TextField fx:id="destinoField"
                   promptText="Ciudad, Pais"
                   prefWidth="300" prefHeight="34"
                   style="-fx-background-color: #EDE8DC;
                          -fx-border-color: #C0B090;
                          -fx-border-width: 1;
                          -fx-padding: 6;"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="FECHA:"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <DatePicker fx:id="fechaPicker" prefWidth="200"/>
    </HBox>

    <Label text="PRODUCTOS DE LA VENTA:"
           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <TableView fx:id="productosTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #EDE8DC;
                      -fx-border-color: #C8BFA8;
                      -fx-border-width: 1;">
        <columns>
            <TableColumn fx:id="colProducto" text="PRODUCTO" prefWidth="280"/>
            <TableColumn fx:id="colCantidad" text="CANTIDAD" prefWidth="120"/>
            <TableColumn fx:id="colPrecio" text="PRECIO" prefWidth="150"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Button text="REGISTRAR ENVIO"
            onAction="#handleRegistrarEnvio"
            prefWidth="220" prefHeight="40"
            style="-fx-background-color: #2B2118;
                   -fx-text-fill: #F5F0E8;
                   -fx-font-size: 13px;
                   -fx-font-weight: bold;
                   -fx-cursor: hand;"/>

</VBox>