<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.InsumoAlcanciaController"
      spacing="16"
      style="-fx-padding: 30; -fx-background-color: #F5F0E8;">

    <Label text="INSUMOS POR ALCANCIA"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="MODELO:"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <TextField fx:id="buscarAlcanciaField"
                   promptText="Escribe para buscar alcancia..."
                   prefWidth="300" prefHeight="36"
                   style="-fx-background-color: #EDE8DC;
                          -fx-border-color: #C0B090;
                          -fx-border-width: 1;
                          -fx-padding: 6;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Agregar insumo"
                onAction="#handleAgregarInsumo"
                prefHeight="36"
                style="-fx-background-color: #2B2118;
                       -fx-text-fill: #F5F0E8;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-padding: 6 16;
                       -fx-cursor: hand;"/>
    </HBox>

    <ListView fx:id="alcanciaListView"
              prefHeight="120"
              style="-fx-background-color: #EDE8DC;
                     -fx-border-color: #C0B090;
                     -fx-border-width: 1;"/>

    <HBox spacing="6">
        <Label text="Alcancia seleccionada:"
               style="-fx-font-weight: bold; -fx-text-fill: #6B5A45;"/>
        <Label fx:id="alcanciaSeleccionadaLabel" text="Ninguna seleccionada"
               style="-fx-text-fill: #6B5A45; -fx-font-style: italic;"/>
    </HBox>

    <TableView fx:id="insumoTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #EDE8DC;
                      -fx-border-color: #C8BFA8;
                      -fx-border-width: 1;">
        <columns>
            <TableColumn fx:id="colNombre" text="NOMBRE" prefWidth="180"/>
            <TableColumn fx:id="colCantidad" text="CANTIDAD" prefWidth="100"/>
            <TableColumn fx:id="colUnidad" text="UNIDAD" prefWidth="90"/>
            <TableColumn fx:id="colCosto" text="COSTO UNIT." prefWidth="110"/>
            <TableColumn fx:id="colSubtotal" text="SUBTOTAL" prefWidth="110"/>
            <TableColumn fx:id="colAcciones" text="ACCIONES" prefWidth="160"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Label text="COSTO TOTAL DE PRODUCCION:"
               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2B2118;"/>
        <Label fx:id="totalLabel" text="0.00"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
    </HBox>

</VBox>