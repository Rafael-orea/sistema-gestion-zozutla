<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.HistorialVentaController"
      spacing="16"
      style="-fx-padding: 30; -fx-background-color: #F5F0E8;">

    <Label text="HISTORIAL DE VENTAS"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <!-- Filtros -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="FECHA:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <DatePicker fx:id="fechaPicker" prefWidth="150"/>

        <Label text="CLIENTE:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <ComboBox fx:id="clienteCombo" prefWidth="180"/>

        <Label text="MODELO:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <ComboBox fx:id="modeloCombo" prefWidth="180"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="BUSCAR"
                onAction="#handleBuscar"
                prefHeight="34"
                style="-fx-background-color: #2B2118;
                       -fx-text-fill: #F5F0E8;
                       -fx-font-size: 12px;
                       -fx-font-weight: bold;
                       -fx-padding: 6 16;
                       -fx-cursor: hand;"/>
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="historialTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1;">
        <columns>
            <TableColumn fx:id="colFecha" text="FECHA" prefWidth="110"/>
            <TableColumn fx:id="colFolio" text="FOLIO" prefWidth="160"/>
            <TableColumn fx:id="colCliente" text="CLIENTE" prefWidth="150"/>
            <TableColumn fx:id="colModelo" text="MODELO" prefWidth="180"/>
            <TableColumn fx:id="colCantidad" text="CANT" prefWidth="70"/>
            <TableColumn fx:id="colTotal" text="TOTAL" prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Resumen -->
    <HBox spacing="30" alignment="CENTER_RIGHT">
        <HBox spacing="8">
            <Label text="Registros:"
                   style="-fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label fx:id="registrosLabel" text="0"
                   style="-fx-text-fill: #2B2118;"/>
        </HBox>
        <HBox spacing="8">
            <Label text="Total general:"
                   style="-fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label fx:id="totalLabel" text="0.00"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        </HBox>
    </HBox>

</VBox>