<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.HistorialVentaController"
      spacing="16"
      style="-fx-padding: 30; -fx-background-color: #F5F0E8;">

    <Label text="HISTORIAL DE VENTAS"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <!-- Filtros fila 1 -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="FECHA:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <DatePicker fx:id="fechaPicker" prefWidth="150"/>

        <Label text="CLIENTE:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <TextField fx:id="clienteSearchField"
                   promptText="Buscar cliente..."
                   prefWidth="200" prefHeight="34"
                   style="-fx-background-color: #EDE8DC;
                          -fx-border-color: #C0B090;
                          -fx-border-width: 1;
                          -fx-padding: 6;"/>

        <Label text="MODELO:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <TextField fx:id="modeloSearchField"
                   promptText="Buscar modelo..."
                   prefWidth="200" prefHeight="34"
                   style="-fx-background-color: #EDE8DC;
                          -fx-border-color: #C0B090;
                          -fx-border-width: 1;
                          -fx-padding: 6;"/>
    </HBox>

    <!-- Listas de búsqueda -->
    <HBox spacing="12">
        <VBox HBox.hgrow="ALWAYS">
            <ListView fx:id="clienteListView"
                      prefHeight="90"
                      style="-fx-background-color: #EDE8DC;
                             -fx-border-color: #C0B090;
                             -fx-border-width: 1;"/>
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <ListView fx:id="modeloListView"
                      prefHeight="90"
                      style="-fx-background-color: #EDE8DC;
                             -fx-border-color: #C0B090;
                             -fx-border-width: 1;"/>
        </VBox>
    </HBox>

    <!-- Filtros fila 2 -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="ESTADO ENVIO:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <ComboBox fx:id="filtroEstadoEnvio" prefWidth="180"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="BUSCAR"
                onAction="#handleBuscar"
                prefHeight="34"
                style="-fx-background-color: #2B2118;
                       -fx-text-fill: #F5F0E8;
                       -fx-font-size: 12px;
                       -fx-font-weight: bold;
                       -fx-padding: 6 16;
                       -fx-cursor: hand;"/>
        <Button text="LIMPIAR"
                onAction="#handleLimpiar"
                prefHeight="34"
                style="-fx-background-color: #EDE8DC;
                       -fx-border-color: #2B2118;
                       -fx-border-width: 1;
                       -fx-font-size: 12px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #2B2118;
                       -fx-padding: 6 16;
                       -fx-cursor: hand;"/>
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="historialTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #EDE8DC;
                      -fx-border-color: #C8BFA8;
                      -fx-border-width: 1;">
        <columns>
            <TableColumn fx:id="colFecha" text="FECHA" prefWidth="110"/>
            <TableColumn fx:id="colFolio" text="FOLIO" prefWidth="160"/>
            <TableColumn fx:id="colCliente" text="CLIENTE" prefWidth="150"/>
            <TableColumn fx:id="colModelo" text="MODELO" prefWidth="160"/>
            <TableColumn fx:id="colCantidad" text="CANT" prefWidth="60"/>
            <TableColumn fx:id="colTotal" text="TOTAL" prefWidth="100"/>
            <TableColumn fx:id="colEstadoEnvio" text="ENVIO" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="30" alignment="CENTER_RIGHT">
        <HBox spacing="8">
            <Label text="Registros:"
                   style="-fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label fx:id="registrosLabel" text="0"
                   style="-fx-text-fill: #2B2118;"/>
        </HBox>
        <HBox spacing="8">
            <Label text="Total general:"
                   style="-fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label fx:id="totalLabel" text="0.00"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        </HBox>
    </HBox>

</VBox>