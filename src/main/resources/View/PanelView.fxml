<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.PanelController"
      alignment="CENTER" spacing="40"
      maxWidth="Infinity" maxHeight="Infinity"
      style="-fx-padding: 60; -fx-background-color: #F5F0E8;">

    <Label text="PANEL PRINCIPAL"
           style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <HBox spacing="30" alignment="CENTER">
        <VBox alignment="CENTER" spacing="12" prefWidth="220" prefHeight="140"
              style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20;">
            <Label text="MOLDES"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6B5A45;"/>
            <Label fx:id="lblMoldes" text="0"
                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label text="total de moldes"
                   style="-fx-font-size: 12px; -fx-text-fill: #8B7A65;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="12" prefWidth="220" prefHeight="140"
              style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20;">
            <Label text="INVENTARIO"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6B5A45;"/>
            <Label fx:id="lblInventario" text="0"
                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label text="piezas disponibles"
                   style="-fx-font-size: 12px; -fx-text-fill: #8B7A65;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="12" prefWidth="220" prefHeight="140"
              style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20;">
            <Label text="VENTAS HOY"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6B5A45;"/>
            <Label fx:id="lblVentasDia" text="0.00"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label text="del dia de hoy"
                   style="-fx-font-size: 12px; -fx-text-fill: #8B7A65;"/>
        </VBox>
    </HBox>

    <HBox spacing="30" alignment="CENTER">
        <VBox alignment="CENTER" spacing="12" prefWidth="300" prefHeight="140"
              style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20;">
            <Label text="VENTAS DEL MES"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6B5A45;"/>
            <Label fx:id="lblVentasMes" text="0.00"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label text="este mes"
                   style="-fx-font-size: 12px; -fx-text-fill: #8B7A65;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="12" prefWidth="300" prefHeight="140"
              style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20;">
            <Label text="GANANCIA ESTIMADA"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6B5A45;"/>
            <Label fx:id="lblGanancia" text="0.00"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label text="ganancia total"
                   style="-fx-font-size: 12px; -fx-text-fill: #8B7A65;"/>
        </VBox>
    </HBox>

</VBox>