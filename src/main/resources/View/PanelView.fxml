<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.PanelController"
      alignment="CENTER" spacing="30"
      style="-fx-padding: 40; -fx-background-color: #F5F0E8;">

    <Label text="PANEL PRINCIPAL"
           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <HBox spacing="20" alignment="CENTER">
        <VBox alignment="CENTER" spacing="8" prefWidth="160" prefHeight="110"
              style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4; -fx-padding: 16;">
            <Label text="MOLDES" style="-fx-font-size: 13px; -fx-text-fill: #6B5A45; -fx-font-weight: bold;"/>
            <Label fx:id="lblMoldes" text="0"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label text="total de moldes" style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="8" prefWidth="160" prefHeight="110"
              style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4; -fx-padding: 16;">
            <Label text="INVENTARIO" style="-fx-font-size: 13px; -fx-text-fill: #6B5A45; -fx-font-weight: bold;"/>
            <Label fx:id="lblInventario" text="0"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label text="piezas disponibles" style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="8" prefWidth="160" prefHeight="110"
              style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4; -fx-padding: 16;">
            <Label text="VENTAS HOY" style="-fx-font-size: 13px; -fx-text-fill: #6B5A45; -fx-font-weight: bold;"/>
            <Label fx:id="lblVentasDia" text="0.00"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label text="del dia de hoy" style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
        </VBox>
    </HBox>

    <HBox spacing="20" alignment="CENTER">
        <VBox alignment="CENTER" spacing="8" prefWidth="240" prefHeight="110"
              style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4; -fx-padding: 16;">
            <Label text="VENTAS DEL MES" style="-fx-font-size: 13px; -fx-text-fill: #6B5A45; -fx-font-weight: bold;"/>
            <Label fx:id="lblVentasMes" text="0.00"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label text="este mes" style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="8" prefWidth="240" prefHeight="110"
              style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4; -fx-padding: 16;">
            <Label text="GANANCIA ESTIMADA" style="-fx-font-size: 13px; -fx-text-fill: #6B5A45; -fx-font-weight: bold;"/>
            <Label fx:id="lblGanancia" text="0.00"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
            <Label text="ganancia total" style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
        </VBox>
    </HBox>

</VBox>