<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.IncidenciaEnvioController"
      spacing="14"
      prefWidth="600" prefHeight="680"
      style="-fx-padding: 24; -fx-background-color: #F5F0E8;">

    <Label text="INCIDENCIAS DE ENVIO"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="FOLIO:"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <Label fx:id="folioLabel" text="----------"
               style="-fx-text-fill: #6B5A45; -fx-font-weight: bold;"/>
    </HBox>

    <Label text="Selecciona el producto afectado:"
           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <TableView fx:id="productosTable" prefHeight="140"
               style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1;">
        <columns>
            <TableColumn fx:id="colProducto" text="PRODUCTO" prefWidth="350"/>
            <TableColumn fx:id="colCantidad" text="CANTIDAD COMPRADA" prefWidth="180"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="productoSeleccionadoLabel" text="Ningun producto seleccionado"
           style="-fx-text-fill: #6B5A45; -fx-font-style: italic;"/>

    <HBox spacing="30" alignment="CENTER_LEFT">
        <VBox spacing="6">
            <Label text="Piezas faltantes"
                   style="-fx-font-size: 12px; -fx-text-fill: #2B2118;"/>
            <Spinner fx:id="faltantesSpinner" prefWidth="100"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Piezas rotas"
                   style="-fx-font-size: 12px; -fx-text-fill: #2B2118;"/>
            <Spinner fx:id="rotasSpinner" prefWidth="100"/>
        </VBox>
    </HBox>

    <VBox spacing="6">
        <Label text="Descripcion:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <TextArea fx:id="descripcionArea"
                  promptText="Detalle de la incidencia..."
                  prefHeight="70" prefWidth="520"
                  style="-fx-background-color: #EDE8DC; -fx-border-color: #C0B090; -fx-border-width: 1;"/>
    </VBox>

    <VBox spacing="10"
          style="-fx-background-color: #EDE8DC; -fx-border-color: #C0B090; -fx-border-width: 1; -fx-padding: 12; -fx-background-radius: 4; -fx-border-radius: 4;">
        <Label text="RESPONSABILIDAD DE LA PERDIDA:"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <RadioButton fx:id="rbCliente100" text="Cliente asume el 100%"
                     style="-fx-font-size: 13px; -fx-text-fill: #2B2118;"/>
        <RadioButton fx:id="rbAcuerdo" text="Acuerdo entre ambos"
                     style="-fx-font-size: 13px; -fx-text-fill: #2B2118;"/>
        <VBox fx:id="acuerdoBox" spacing="10">
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Cliente asume:"
                       style="-fx-font-size: 12px; -fx-text-fill: #2B2118;"/>
                <Spinner fx:id="porcentajeClienteSpinner" prefWidth="90"/>
                <Label text="pct" style="-fx-font-size: 12px; -fx-text-fill: #2B2118;"/>
            </HBox>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Zozutla asume:"
                       style="-fx-font-size: 12px; -fx-text-fill: #2B2118;"/>
                <Spinner fx:id="porcentajeZozutlaSpinner" prefWidth="90"/>
                <Label text="pct" style="-fx-font-size: 12px; -fx-text-fill: #2B2118;"/>
            </HBox>
        </VBox>
    </VBox>

    <Button text="GUARDAR INCIDENCIA"
            onAction="#handleGuardarIncidencia"
            prefWidth="220" prefHeight="40"
            style="-fx-background-color: #2B2118; -fx-text-fill: #F5F0E8; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>

</VBox>