<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.InicioController"
      alignment="CENTER"
      spacing="30"
      prefWidth="600" prefHeight="500"
      style="-fx-background-color: #F5F0E8;">

    <children>
        <Label text="Sistema de Gestión"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3B2A1A; -fx-underline: true;"/>
        <Label text="Artesanías Zozutla"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3B2A1A; -fx-underline: true;"/>

        <ImageView fx:id="logoImage"
                   fitWidth="220" fitHeight="220"
                   preserveRatio="true"/>

        <Button text="INGRESAR"
                onAction="#handleIngresar"
                prefWidth="160" prefHeight="40"
                style="-fx-background-color: #E8E0D0;
                       -fx-border-color: #3B2A1A;
                       -fx-border-width: 1;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #3B2A1A;
                       -fx-cursor: hand;"/>
    </children>
</VBox>