<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.InicioController"
            prefWidth="1280"
            prefHeight="720"
            stylesheets="@/css/inicio.css"
            styleClass="background">

    <!-- Imagen de fondo -->
    <center>

        <StackPane>

            <!-- Fondo -->
            <ImageView fx:id="backgroundImage"
                       fitWidth="1280"
                       fitHeight="720"
                       preserveRatio="false"/>

            <!-- Capa oscura -->
            <BorderPane styleClass="overlay">

                <!-- Información -->
                <left>

                    <VBox spacing="22"
                          alignment="CENTER_LEFT"
                          styleClass="welcome-panel">

                        <padding>
                            <Insets top="70"
                                    right="60"
                                    bottom="70"
                                    left="70"/>
                        </padding>

                        <Label text="Artesanías Zozutla"
                               styleClass="welcome-title"/>

                        <Label text="Sistema de gestión"
                               styleClass="welcome-subtitle"/>

                        <Label text="Administra clientes, ventas, inventario, moldes e insumos de una forma rápida y segura."
                               wrapText="true"
                               maxWidth="430"
                               styleClass="welcome-description"/>

                        <Button text="ACCEDER AL SISTEMA"
                                prefWidth="240"
                                prefHeight="55"
                                onAction="#handleIngresar"
                                styleClass="welcome-button"/>

                    </VBox>

                </left>

                <!-- Logo -->
                <right>

                    <StackPane alignment="CENTER">

                        <padding>
                            <Insets right="80"/>
                        </padding>

                        <ImageView fx:id="logoImage"
                                   fitWidth="500"
                                   fitHeight="500"
                                   preserveRatio="true"
                                   styleClass="logo-image"/>

                    </StackPane>

                </right>

            </BorderPane>

        </StackPane>

    </center>

</BorderPane>