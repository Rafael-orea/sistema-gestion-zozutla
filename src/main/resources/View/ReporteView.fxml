<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.ReporteController"
      spacing="16"
      style="-fx-padding: 24; -fx-background-color: #F5F0E8;">

    <Label text="REPORTES"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>

    <HBox spacing="12" alignment="CENTER_LEFT"
          style="-fx-background-color: #EDE8DC; -fx-border-color: #C0B090;
                 -fx-border-width: 1; -fx-padding: 12;
                 -fx-background-radius: 4; -fx-border-radius: 4;">
        <Label text="PERIODO:"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
        <Label text="Del" style="-fx-text-fill: #2B2118;"/>
        <DatePicker fx:id="fechaInicioPicker" prefWidth="150"/>
        <Label text="al" style="-fx-text-fill: #2B2118;"/>
        <DatePicker fx:id="fechaFinPicker" prefWidth="150"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="GENERAR REPORTE"
                onAction="#handleGenerar"
                prefHeight="34"
                style="-fx-background-color: #2B2118; -fx-text-fill: #F5F0E8;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-padding: 6 16; -fx-cursor: hand;"/>
    </HBox>

    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS">

        <Tab text="GANANCIAS" closable="false">
            <VBox spacing="16" style="-fx-padding: 16; -fx-background-color: #F5F0E8;">

                <HBox spacing="16">
                    <VBox alignment="CENTER" spacing="6" prefWidth="180" prefHeight="90"
                          style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8;
                                 -fx-border-width: 1; -fx-background-radius: 4;
                                 -fx-border-radius: 4; -fx-padding: 12;">
                        <Label text="TOTAL VENDIDO"
                               style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
                        <Label fx:id="lblTotalVentas" text="0.00"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="6" prefWidth="180" prefHeight="90"
                          style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8;
                                 -fx-border-width: 1; -fx-background-radius: 4;
                                 -fx-border-radius: 4; -fx-padding: 12;">
                        <Label text="NUM. VENTAS"
                               style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
                        <Label fx:id="lblNumVentas" text="0"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="6" prefWidth="180" prefHeight="90"
                          style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8;
                                 -fx-border-width: 1; -fx-background-radius: 4;
                                 -fx-border-radius: 4; -fx-padding: 12;">
                        <Label text="DESCUENTOS APLICADOS"
                               style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
                        <Label fx:id="lblDescuentos" text="0.00"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="6" prefWidth="180" prefHeight="90"
                          style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8;
                                 -fx-border-width: 1; -fx-background-radius: 4;
                                 -fx-border-radius: 4; -fx-padding: 12;">
                        <Label text="GANANCIA NETA"
                               style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
                        <Label fx:id="lblGananciaNet" text="0.00"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </VBox>
                </HBox>

                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="TOP 10 PRODUCTOS MAS VENDIDOS"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
                        <TableView fx:id="topProductosTable" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1;">
                            <columns>
                                <TableColumn fx:id="colTopNombre" text="PRODUCTO" prefWidth="200"/>
                                <TableColumn fx:id="colTopPiezas" text="PIEZAS" prefWidth="80"/>
                                <TableColumn fx:id="colTopTotal" text="TOTAL" prefWidth="100"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="VENTAS POR CLIENTE"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
                        <TableView fx:id="clientesTable" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1;">
                            <columns>
                                <TableColumn fx:id="colClienteNombre" text="CLIENTE" prefWidth="180"/>
                                <TableColumn fx:id="colClienteVentas" text="VENTAS" prefWidth="70"/>
                                <TableColumn fx:id="colClienteTotal" text="TOTAL" prefWidth="100"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_RIGHT">
                    <Button text="Exportar Ganancias a Excel"
                            onAction="#handleExportarGanancias"
                            prefHeight="34"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-padding: 6 16; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </Tab>

        <Tab text="PERDIDAS" closable="false">
            <VBox spacing="16" style="-fx-padding: 16; -fx-background-color: #F5F0E8;">

                <HBox spacing="16">
                    <VBox alignment="CENTER" spacing="6" prefWidth="220" prefHeight="90"
                          style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8;
                                 -fx-border-width: 1; -fx-background-radius: 4;
                                 -fx-border-radius: 4; -fx-padding: 12;">
                        <Label text="PERDIDAS POR MERMA"
                               style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
                        <Label fx:id="lblPerdidasMerma" text="0.00"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="6" prefWidth="220" prefHeight="90"
                          style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8;
                                 -fx-border-width: 1; -fx-background-radius: 4;
                                 -fx-border-radius: 4; -fx-padding: 12;">
                        <Label text="PERDIDAS POR ENVIO ZOZUTLA"
                               style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
                        <Label fx:id="lblPerdidasEnvio" text="0.00"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="6" prefWidth="220" prefHeight="90"
                          style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8;
                                 -fx-border-width: 1; -fx-background-radius: 4;
                                 -fx-border-radius: 4; -fx-padding: 12;">
                        <Label text="TOTAL PERDIDAS"
                               style="-fx-font-size: 11px; -fx-text-fill: #8B7A65;"/>
                        <Label fx:id="lblPerdidasTotal" text="0.00"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    </VBox>
                </HBox>

                <Label text="DETALLE DE MERMAS"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
                <TableView fx:id="mermasTable" prefHeight="200"
                           style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1;">
                    <columns>
                        <TableColumn fx:id="colMermaNombre" text="PRODUCTO" prefWidth="180"/>
                        <TableColumn fx:id="colMermaCantidad" text="CANT" prefWidth="60"/>
                        <TableColumn fx:id="colMermaMotivo" text="MOTIVO" prefWidth="250"/>
                        <TableColumn fx:id="colMermaFecha" text="FECHA" prefWidth="100"/>
                        <TableColumn fx:id="colMermaValor" text="VALOR" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <Label text="DETALLE DE INCIDENCIAS DE ENVIO"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B2118;"/>
                <TableView fx:id="incidenciasTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #EDE8DC; -fx-border-color: #C8BFA8; -fx-border-width: 1;">
                    <columns>
                        <TableColumn fx:id="colIncFolio" text="FOLIO" prefWidth="140"/>
                        <TableColumn fx:id="colIncProducto" text="PRODUCTO" prefWidth="150"/>
                        <TableColumn fx:id="colIncCantidad" text="CANT" prefWidth="55"/>
                        <TableColumn fx:id="colIncResponsabilidad" text="RESPONSABILIDAD" prefWidth="120"/>
                        <TableColumn fx:id="colIncPctCliente" text="PCT CLI" prefWidth="70"/>
                        <TableColumn fx:id="colIncPctZozutla" text="PCT ZOZ" prefWidth="70"/>
                        <TableColumn fx:id="colIncPerdidaZozutla" text="PERDIDA ZOZUTLA" prefWidth="120"/>
                        <TableColumn fx:id="colIncFecha" text="FECHA" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT">
                    <Button text="Exportar Perdidas a Excel"
                            onAction="#handleExportarPerdidas"
                            prefHeight="34"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-padding: 6 16; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>